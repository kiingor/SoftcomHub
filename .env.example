# Web Push (generate a pair with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@softcomtecnologia.com

# Vercel Cron authentication
CRON_SECRET=

# Optional fallback when a channel has no Evolution credentials stored
EVOLUTION_BASE_URL=https://whatsapi.mensageria.softcomtecnologia.com
EVOLUTION_GLOBAL_API_KEY=

# Consulta de cliente por CNPJ (API preferencial + fallback pelo webhook legado)
SOFTCOM_API_URL=https://api.softcom.cloud/v1
SOFTCOM_API_KEY=
GETCLIENT_WEBHOOK_URL=https://n8n-webhook.mensageria.softcomtecnologia.com/webhook/getcliente

# Trava de OC no encerramento (caso #97240) — WorkDesk.
# Ligada, o atendente não encerra o ticket enquanto o Service Desk não tiver uma
# ocorrência para o número dele (GET {SOFTCOM_API_URL}/tickets/numero/{numero},
# header x-api-key = SOFTCOM_API_KEY). Sem SOFTCOM_API_KEY a consulta responde
# 401 e o encerramento é LIBERADO — a trava nunca vira fila parada por causa da
# API externa; só uma resposta clara de "não existe OC" bloqueia.
# Desligada (padrão): comportamento idêntico ao de hoje, sem nem consultar.
# Valores que ligam: 1, true, sim, on.
# PRÉ-REQUISITO para ligar: SOFTCOM_API_KEY configurada E confirmado que o
# número do ticket do Hub é encontrado nessa rota.
OC_OBRIGATORIA_PARA_ENCERRAR=

# Combo dedicado do "Status do atendimento" (Setor -> Monitoramento -> conversa).
# É ferramenta de supervisor, igual em todo setor: com a chave abaixo definida, a
# análise NÃO depende da IA configurada setor a setor. Sem ela, degrada para a
# config do setor (Setor -> Configurações -> Inteligência Artificial).
# `analise-atendimento` é um combo priority no OmniRoute, criado para esta tela.
# Ordem definida por medição em 06/08/2026 sobre conversas reais (31 e 12
# mensagens): Haiku 4.5 sem thinking (~4,9s) → Haiku com thinking (~6,0s) →
# MiniMax M2.5 (~7,8s) → gpt-5.4-mini (~9,0s) → MiniMax highspeed (fora do
# command-code, para sobreviver à queda do provider). Ficaram DE FORA por
# reprovarem no teste: Step-3.7-Flash e deepseek-v4-flash devolveram resposta
# vazia, e gemini-3.5-flash ignorou o formato das seções.
ANALISE_IA_BASE_URL=https://omniroute.mensageria.softcomtecnologia.com/v1
ANALISE_IA_API_KEY=
ANALISE_IA_MODEL=analise-atendimento
